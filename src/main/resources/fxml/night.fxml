<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="viewport" styleClass="viewport" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.untildawn.controller.NightController">
    <Group>
        <AnchorPane fx:id="design" prefWidth="1280" prefHeight="720"
                    minWidth="1280" minHeight="720" maxWidth="1280" maxHeight="720" styleClass="night-screen">
            <Pane styleClass="camera-frame" mouseTransparent="true"
                  AnchorPane.topAnchor="26" AnchorPane.rightAnchor="26"
                  AnchorPane.bottomAnchor="26" AnchorPane.leftAnchor="26"/>
            <VBox alignment="CENTER" spacing="20" prefWidth="1280" layoutY="238">
                <Label text="YOUR ONLY SHIFT" styleClass="eyebrow"/>
                <Label fx:id="nightLabel" text="NIGHT 01" styleClass="night-heading"/>
                <Label fx:id="timeLabel" text="12:00 AM" styleClass="night-time"/>
                <Region prefHeight="4"/>
                <Label fx:id="shiftLabel" styleClass="night-caption"/>
            </VBox>
            <HBox alignment="CENTER" prefWidth="1280" AnchorPane.bottomAnchor="96">
                <Button fx:id="backButton" text="←  BACK TO LOBBY" onAction="#handleBack" styleClass="outline-button"/>
            </HBox>
            <Label text="ESC TO RETURN" styleClass="footer-label" layoutX="56" AnchorPane.bottomAnchor="46"/>
        </AnchorPane>
    </Group>
</StackPane>
